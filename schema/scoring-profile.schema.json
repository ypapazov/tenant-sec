{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenant-sec.dev/schema/scoring-profile.schema.json",
  "title": "Scoring Profile Schema",
  "description": "Validates files in profiles/",
  "$defs": {
    "must_have_entry": {
      "type": "object",
      "properties": {
        "control": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]+(\\.[a-z][a-z0-9-]+)?$"
        },
        "min_level": {
          "type": "integer",
          "enum": [0, 1, 2, 3]
        }
      },
      "required": ["control", "min_level"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "methodology_version": { "type": "string", "minLength": 1 },
    "must_have": {
      "type": "array",
      "items": { "$ref": "#/$defs/must_have_entry" },
      "default": []
    },
    "must_have_certifications": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$",
        "description": "Certification catalogue id, e.g. bsi-c5-type2"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Named programmes that must be currently held for this offering. Eligibility gate, not a maturity score."
    },
    "min_catalog_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Minimum fraction of applicable tenant controls that must be in state assessed. Omit to require only that must-have controls are assessed."
    },
    "min_catalog_completeness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Methodology-2 name for the minimum assessed fraction. min_catalog_coverage is retained for v1 compatibility."
    },
    "cohort": {
      "type": "string",
      "enum": ["hyperscaler", "eu-public", "cost-focused", "sovereign", "dedicated", "watchlist"],
      "description": "Only assessments in this comparison cohort are eligible."
    },
    "service_coverage_thresholds": {
      "type": "array",
      "items": { "type": "integer", "enum": [2, 3] },
      "minItems": 1,
      "uniqueItems": true,
      "default": [2, 3]
    },
    "weights": {
      "type": "object",
      "propertyNames": {
        "enum": ["iam", "governance", "encryption", "network", "logging", "data", "compute", "incident", "supply-chain"]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Domain weights; must sum to 1.0 (validated in code, not schema)"
    },
    "mixed_aggregation": {
      "type": "string",
      "pattern": "^(min|mean|median|p10|p20|threshold:L[0-3]:[0-9]+(\\.[0-9]+)?)$",
      "description": "How to aggregate mixed composite scores: min, mean, median, p10, p20, or threshold:L{n}:{pct}"
    }
  },
  "required": ["name", "weights", "mixed_aggregation"],
  "allOf": [
    {
      "if": {
        "properties": {
          "methodology_version": { "pattern": "^2\\." }
        },
        "required": ["methodology_version"]
      },
      "then": {
        "required": ["cohort"]
      }
    }
  ],
  "additionalProperties": false
}
